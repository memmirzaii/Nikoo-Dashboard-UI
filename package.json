{
  "name": "nikoo-ai-dashboard",
  "version": "1.0.0",
  "description": "Nikoo AI Dashboard - A comprehensive Persian RTL dashboard with AI integration",
  "main": "assets/js/main.js",
  "scripts": {
    "dev": "concurrently \"npm run tailwind:watch\" \"npm run serve\"",
    "build": "npm run tailwind:build",
    "tailwind:watch": "postcss assets/css/input.css -w -o assets/css/output.css",
    "tailwind:build": "postcss assets/css/input.css -o assets/css/output.css --minify",
    "serve": "live-server --port=3000 --host=0.0.0.0 --watch=pages,assets",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "stylelint assets/css/**/*.css",
    "lint:js": "eslint assets/js/**/*.js",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules/.cache dist",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "dashboard",
    "rtl",
    "persian",
    "farsi",
    "tailwindcss",
    "ai",
    "nikoo"
  ],
  "author": "Nikoo Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "postcss-rtl": "^2.0.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-rtl": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/memmirzaii/Nikoo-Dashboard-UI.git"
  },
  "bugs": {
    "url": "https://github.com/memmirzaii/Nikoo-Dashboard-UI/issues"
  },
  "homepage": "https://github.com/memmirzaii/Nikoo-Dashboard-UI#readme"
}
